# =========================================================================
# 🧞‍♂️ WEALTHGENIE UNIFIED ENVIRONMENT CONFIGURATION
# =========================================================================

# ── Express API Backend Server ───────────────────────────────────────────
# Port where the Node Express server will listen
PORT=5000
# Run environment: "development" (enables verbose errors) or "production"
NODE_ENV=development
# Optional runtime-mounted build provenance document; CI mounts and verifies it.
APP_BUILD_PROVENANCE_PATH=
# MongoDB must run as a replica set for atomic advisory and goal transactions.
# Docker Compose uses mongodb://mongodb:27017/wealthgenie?replicaSet=rs0.
MONGODB_URI=mongodb://localhost:27017/wealthgenie?replicaSet=rs0
# mongodb is the default. Use documentdb only with a verified CA bundle in production.
MONGODB_FLAVOR=mongodb
MONGODB_TLS_CA_FILE=
# Redis cache/rate limit connection URI (use 'redis://redis:6379' for local docker-compose)
REDIS_URL=redis://localhost:6379
# JWT Secret Key (min 32 characters for security)
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS_LONG
# Session expiry time (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d
# HttpOnly browser session settings. Keep bearer-token exposure disabled in production.
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_COOKIE_SAME_SITE=strict
# Always secure in production. Enable locally only when developing over HTTPS.
AUTH_COOKIE_SECURE=false
EXPOSE_AUTH_TOKEN=false
# CORS allowed origins (comma-separated whitelisted domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Number of trusted reverse-proxy hops. Use 0 for direct public binding and 1 behind one proxy.
TRUST_PROXY=0
# Direct Node.js production lifecycle controls (milliseconds)
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=65000
HTTP_KEEP_ALIVE_TIMEOUT_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
SLOW_REQUEST_MS=3000
# Reject excess work before event-loop and database saturation.
MAX_IN_FLIGHT_REQUESTS=250
DEEP_HEALTH_TIMEOUT_MS=3000
# Production defaults to true because session revocation fails closed through Redis.
REQUIRE_REDIS=false
# Local development: enable bounded Plan Review. External-worker deployments
# must start the worker and run the Phase 4/5 indexes before serving traffic.
# Production uses the separately validated deploy/production overlay.
AGENTIC_PLAN_REVIEW_ENABLED=true
AGENT_STREAM_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_TOOL_CALLS_PER_TOOL=2
AGENT_TIMEOUT_MS=30000
# MongoDB driver pool and failure-detection controls.
MONGODB_AUTO_INDEX=true
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_IDLE_TIME_MS=60000
# Dedicated secret used by infrastructure scrapers through X-Metrics-Token.
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN_AT_LEAST_32_CHARACTERS

# ── Machine Learning (FastAPI) Microservice ──────────────────────────────
# ML service root URL (Express backend uses this to query RandomForest/SHAP predictions)
ML_SERVICE_URL=http://localhost:8000
# Port for FastAPI ML Service
ML_PORT=8000
# Shared inter-service authentication key (protects FastAPI endpoints)
ML_SERVICE_API_KEY=CHANGE_ME_ML_SERVICE_API_KEY
# Out-of-band key for ML model switching and other operator-only endpoints.
ML_OPERATOR_KEY=CHANGE_ME_ML_OPERATOR_KEY
# Path to RandomForest model pickle file (defaults to ./model/model.pkl)
MODEL_PATH=./model/model.pkl

# Open-Weight LLM Platform Configuration
LLM_DEFAULT_PROVIDER=huggingface
LLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LLM_DEVICE=cpu
LLM_QUANTIZATION=float32

# ── AI Integrations (External APIs) ──────────────────────────────────────
# Google Gemini API key (enables AI financial advisory chat)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Groq API key failover (for Llama models)
GROQ_API_KEY=your_groq_api_key_here

# ── Frontend (Vite App) ──────────────────────────────────────────────────
# API Server base URL for Vite frontend communication
VITE_API_URL=http://localhost:5000/api
# Browser request deadline. Individual long-running operations may override this.
VITE_API_TIMEOUT_MS=20000
# Optional local API-client compatibility; production builds always use HttpOnly cookies.
VITE_ENABLE_BEARER_AUTH=false

# Household Runway remains disabled until index migration + release qualification.
RUNWAY_ENABLED=false
# Frontend build-time flag (configure separately in reactapp/Vite env):
# VITE_RUNWAY_ENABLED=false
