# WealthGenie frontend environment configuration
# Copy this file to .env inside reactapp for local overrides.

# Base URL for the Express backend API.
VITE_API_URL=http://127.0.0.1:5000/api

# Optional Vite development proxy target when VITE_API_URL is not supplied.
VITE_DEV_API_TARGET=http://127.0.0.1:5000

# Vite provides import.meta.env.DEV automatically in development mode.
# Do not define DEV manually in .env files.

# Optional private financial workspaces; production Docker builds default to false.
VITE_COVERAGE_ENABLED=false
VITE_RUNWAY_ENABLED=false
