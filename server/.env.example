# 🧞‍♂️ WealthGenie Express Backend Environment Configuration
# Use this template file to create your own local ".env" file in the "server" directory.

# =========================================================================
# 🖥️ SERVER CONFIGURATION
# =========================================================================

# The port where your local Express API backend server will run.
# Default is 5000. If changed, ensure the frontend matches this port.
PORT=5000

# OpenTelemetry JSONL export path. Containers override this to /app/traces.jsonl,
# which is writable by the non-root runtime user.
TRACE_LOG_PATH=./traces.jsonl

# The execution environment. Use "development" for local coding (enables
# verbose error logs) or "production" for deployed setups.
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API.
# Local Vite and preview defaults are included below.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173


# =========================================================================
# 📊 DATABASE CONFIGURATION (MongoDB)
# =========================================================================

# The connection string for your MongoDB database.
# For local setup, run a replica set: mongodb://localhost:27017/wealthgenie?replicaSet=rs0
# For cloud setups: Use MongoDB Atlas.
# To get a free cloud database cluster, sign up at: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wealthgenie?retryWrites=true&w=majority
# Select documentdb only when connecting to Amazon DocumentDB. In production
# DocumentDB mode, provide the AWS CA bundle and keep certificate verification enabled.
MONGODB_FLAVOR=mongodb
MONGODB_TLS_CA_FILE=


# =========================================================================
# 🔑 SECURITY & SESSION MANAGEMENT (JWT)
# =========================================================================

# JSON Web Token (JWT) secret key used to sign and verify user session tokens.
# Keep this extremely secure! For development, any long random string will do.
# For production, generate a secure 64-character hex key (e.g. via running `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS_LONG

# How long a user session remains active before requiring a log in again.
# Formats: "7d" (7 days), "24h" (24 hours), "2h" (2 hours).
JWT_EXPIRES_IN=7d


# =========================================================================
# ⚡ CACHING & RATE LIMITING (Redis)
# =========================================================================

# Connection URL for your Redis server.
# Used for rate-limiting API requests and caching AI model prompts to save token costs.
# For local Redis: redis://localhost:6379
# For a free hosted Redis instance, sign up at Upstash: https://console.upstash.com
REDIS_URL=redis://localhost:6379


# =========================================================================
# 📈 OFFICIAL MARKET DATA
# LEGACY routes use isolated NSE website adapters. Production source rights
# remain separately gated; endpoint availability does not grant reuse rights.
MARKET_DATA_PRIMARY_PROVIDER=NSE
# Opt-in market ingestion. UPSTOX_ONLY disables NSE market-data requests;
# existing official NAV/rate sources remain separately rights-gated.
MARKET_DATA_MODE=LEGACY

# =========================================================================

# Optional authenticated Upstox adapter for future/explicit use only.
# When MARKET_DATA_PRIMARY_PROVIDER=UPSTOX, a read-only Analytics token is
# preferred. If both token values are blank, that selected adapter fails closed.
UPSTOX_ANALYTICS_TOKEN=
# A standard access token is supported as a fallback when supplied server-side.
UPSTOX_ACCESS_TOKEN=
# Keep false in production until the applicable public market-data distribution
# rights have been verified and explicitly approved by an operator.
UPSTOX_PUBLIC_MARKET_DATA_LICENSE_CONFIRMED=false

# Optional private educational demo (not public market-data publication).
# The active marketQuotes route also requires auth and loopback Host/socket.
MARKET_DATA_PRIVATE_DEMO_ENABLED=false
PRIVATE_MARKET_READ_ONLY_PROBE_ENABLED=false

# Qualified, licensed durable equity history (not a private demo switch).
# Disabled until the exact provider/exchange rights permit persistent storage,
# derived calculation and public app display. See docs/operations/qualified-market-history.md.
MARKET_EQUITY_HISTORY_STORE_ENABLED=false
# Explicit approved retention window in days, 1-365; leave 0 until verified.
MARKET_EQUITY_HISTORY_RETENTION_DAYS=0

# =========================================================================
# 🤖 MACHINE LEARNING MICROSERVICE URL
# =========================================================================

# The local URL where the Python FastAPI machine learning microservice is running.
# Default is http://localhost:8000.
ML_SERVICE_URL=http://localhost:8000


# =========================================================================
# 🧠 AI CHAT INTEGRATION (Groq primary; Gemini controlled backup)
# =========================================================================

# Optional explicitly selected NVIDIA NIM provider. It is never an automatic
# fallback for Groq or Gemini. Keys remain server-side.
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_PRIMARY_PROVIDER=GROQ
GROQ_MODEL=openai/gpt-oss-120b
# Enable only when the durable PlanReview per-run budget is active.
LLM_GEMINI_FALLBACK_ENABLED=false

# Agent platform controls. Mongo remains the durable workflow backend.
AGENT_IDENTITY_PROVIDER=development
AGENT_WORKFLOW_BACKEND=mongo
AGENT_STREAM_ENABLED=false
AGENT_EVOLUTION_ENABLED=false
AGENT_RESEARCH_ENABLED=false

# ResearchMesh is additive, read-only, and disabled by default. Enable only
# with verified agent identity, an approved search provider, and reviewed A2A
# network configuration.
# The ResearchAgent RSA identity key also signs public-document fetch
# observations; the backend verifies them with the locally pinned public JWK.
AGENT_A2A_V1_ENABLED=false
AGENT_DEEP_RESEARCH_ENABLED=false
AGENT_ADAPTIVE_RESEARCH_ENABLED=false
AGENT_RESEARCH_LIVE_SEARCH_ENABLED=false
AGENT_A2A_RESEARCH_URL=http://127.0.0.1:5088
AGENT_A2A_PUBLIC_URL=http://127.0.0.1:5088
AGENT_A2A_DEV_TOKEN=
AGENT_A2A_CLIENT_TOKEN=
AGENT_A2A_CARD_SIGNING_ENABLED=false
AGENT_A2A_CARD_SIGNING_KEY_ID=
AGENT_A2A_CARD_SIGNING_PRIVATE_KEY=
AGENT_A2A_CARD_SIGNING_PUBLIC_JWK=
RESEARCH_SEARCH_PROVIDER=fixture
RESEARCH_SEARCH_PROVIDER_URL=
RESEARCH_SEARCH_PROVIDER_TOKEN=

# Verifiable intent is disabled by default. When enabled in production it
# requires WebAuthn/passkey step-up approval and configured Ed25519 keys.
AGENT_VERIFIABLE_ACTIONS_ENABLED=false
AGENT_WEBAUTHN_APPROVAL_ENABLED=false
AGENT_AP2_RESEARCH_ENABLED=false
AGENT_APPROVAL_PROVIDER=development
AGENT_MANDATE_TTL_SECONDS=300
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
# Never commit real private keys. Supply production keys through a secret
# manager; development uses an in-process ephemeral key only.
AUTHORIZATION_SIGNING_KEY_ID=
AUTHORIZATION_SIGNING_PRIVATE_KEY=
AUTHORIZATION_SIGNING_PUBLIC_KEY=

# Your API Key to access Google's Gemini models (used for the financial advisory chat).
# Get a free developer key at Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Server-side Groq API key for the configured primary model.
GROQ_API_KEY=your_groq_api_key_here

# Shared inter-service API key for secure communication with FastAPI ML microservice.
ML_SERVICE_API_KEY=CHANGE_ME_ML_SERVICE_API_KEY

# Dedicated secret required to read /api/metrics in production.
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN_AT_LEAST_32_CHARACTERS

# Model Context Protocol. Remote MCP is disabled by default in production.
# Development enables the stateless Streamable HTTP endpoint on localhost only.
MCP_ENABLED=true
MCP_REMOTE_ENABLED=true
# Legacy SSE was removed and this must remain false.
MCP_LEGACY_SSE_ENABLED=false
# Production remote MCP additionally requires resource-specific bearer claims.
MCP_JWT_SECRET=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
MCP_REQUIRED_SCOPE=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# In production, terminate TLS directly (MCP_DIRECT_TLS=true) or provide the
# exact trusted ingress CIDRs; X-Forwarded-Proto is ignored from other peers.
MCP_DIRECT_TLS=false
TRUSTED_PROXY_CIDRS=
MCP_MAX_REQUEST_BYTES=32768
MCP_RATE_WINDOW_MS=60000
MCP_MAX_REQUESTS_PER_WINDOW=120
MCP_MAX_LOW_COST_CALLS_PER_WINDOW=60
MCP_MAX_MEDIUM_COST_CALLS_PER_WINDOW=30
MCP_MAX_HIGH_COST_CALLS_PER_WINDOW=10
MCP_MAX_CONCURRENT_PER_USER=3
MCP_MAX_CONCURRENT_GLOBAL=100
MCP_PERMIT_TTL_MS=90000
MCP_TOOL_TIMEOUT_MS=30000
MCP_SHUTDOWN_GRACE_MS=10000
MCP_XIRR_MAX_CASHFLOWS=600
MCP_XIRR_MAX_ABS_AMOUNT=1000000000000
