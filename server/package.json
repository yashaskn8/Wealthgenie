{
  "name": "wealthgenie-ai-server",
  "version": "1.0.0",
  "description": "WealthGenie Express.js Backend - Tax-optimized AI financial advisory",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "start:worker": "node worker.js",
    "genieproof:verify": "node scripts/verifyGenieProofPassport.js",
    "test": "node scripts/test-partition.js full",
    "test:unit": "node scripts/test-partition.js full",
    "test:coverage": "npx c8 --reporter=text --reporter=text-summary --reporter=json --reporter=lcovonly --reports-dir=reports node scripts/test-partition.js full",
    "test:coverage:unit": "npx c8 --reporter=text --reporter=text-summary --reporter=json --reporter=lcovonly --reports-dir=reports node scripts/test-partition.js full",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "node --check server.js",
    "loadtest": "node scripts/loadtest.js",
    "measure:profile-completion": "node scripts/measure_profile_completion_latency.js",
    "seed": "node config/seedInstruments.js",
    "catalog:sync": "node scripts/syncFrontendCatalog.js",
    "qualify:nse": "node scripts/qualifyNseProvider.js",
    "qualify:fixed-income": "node scripts/qualifyFixedIncomeProviders.js",
    "qualify:nim": "node scripts/qualifyNvidiaNim.js",
    "market-data:coverage": "node scripts/generateMarketDataCoverage.js",
    "post-tax:coverage": "node scripts/exportPostTaxCoverageMatrix.js --check",
    "demo:preflight": "node scripts/demoPreflight.js",
    "demo:doctor": "node scripts/demoDoctor.js",
    "export:market-regime-data": "node scripts/exportMarketRegimeDataset.js",
    "eval": "node scripts/run-eval.js",
    "eval:live": "node scripts/run-live-plan-review-evals.js",
    "test:reliability": "node --test --test-concurrency=1 test/reliabilityLab.test.js",
    "profile:migrate": "node scripts/migrateFinancialProfilesV4.js",
    "migrate:phase2-indexes": "node scripts/migratePhase2Indexes.js",
    "migrate:phase4-plan-review-indexes": "node scripts/migratePlanReviewIndexes.js",
    "migrate:phase5-agent-runtime": "node scripts/migratePhase5AgentRuntimeIndexes.js",
    "migrate:phase7-research-tasks": "node scripts/migrateResearchTaskIndexes.js",
    "migrate:genieproof-evidence": "node scripts/migrateGenieProofEvidenceRegistry.js",
    "market:doctor": "node scripts/marketIntegrationDoctor.js",
    "market:ensure-benchmark-quote-indexes": "node scripts/ensureBenchmarkQuoteIndexes.js",
    "finance:pg:migrate": "node scripts/migrateFinancialPostgres.js",
    "finance:pg:seed": "node scripts/seedFinancialUniverse.js",
    "finance:pg:prune": "node scripts/pruneFinancialPostgres.js",
    "finance:mongo:migrate-indexes": "node scripts/migrateFinancialPrivateIndexes.js",
    "finance:mongo:prune-valuations": "node scripts/prunePrivateFinancialValuations.js",
    "finance:top3:audit": "node scripts/auditFinancialTopThreeCoverage.js",
    "finance:top3:qualify": "node scripts/qualifyFinancialFamily.js",
    "finance:top3:review-queue": "node scripts/generateFinancialTopThreeEvidenceQueue.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.0",
    "@langchain/langgraph": "^1.4.16",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@simplewebauthn/server": "^13.3.3",
    "ajv": "8.18.0",
    "axios": "1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "e2b": "2.51.0",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "8.7.0",
    "fast-check": "^4.8.0",
    "helmet": "^8.0.0",
    "joi": "18.2.9",
    "joi-to-json": "^5.0.5",
    "joi-to-json-schema": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "8.24.4",
    "morgan": "1.12.1",
    "pg": "8.16.3",
    "rate-limit-redis": "^5.0.0",
    "redis": "^4.7.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "follow-redirects": "1.16.1",
    "@grpc/grpc-js": "1.14.5",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "@hono/node-server": "2.1.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@testcontainers/mongodb": "^12.1.0",
    "ajv-formats": "^3.0.1",
    "autocannon": "^8.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "mongodb-memory-server": "^11.2.0",
    "testcontainers": "^12.1.0",
    "yaml": "^2.9.0"
  }
}
