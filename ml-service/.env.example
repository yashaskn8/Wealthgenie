# WealthGenie ML service environment configuration
# Copy this file to .env inside ml-service for local overrides.

# Set an explicit mode. Unset or unsupported values fail closed at service startup.
ENVIRONMENT=local
# auto selects MongoDB in production and local files only in local/test when
# MONGODB_URI is absent. Production explicitly forbids local JSON/SQLite state.
ML_STATE_BACKEND=auto

# Path to the trained RandomForest model file.
# Defaults to ml-service/model/model.pkl when omitted.
MODEL_PATH=./model/model.pkl

# Comma-separated frontend/backend origins allowed to call the FastAPI service.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173

# Port used by uvicorn when running main.py directly.
PORT=8000

# OpenTelemetry JSONL export path. The default preserves the repository-level
# local trace file; containers override this to /app/traces.jsonl.
TRACE_LOG_PATH=../traces.jsonl

# Shared inter-service API key for secure communication with Express backend.
ML_SERVICE_API_KEY=CHANGE_ME_ML_SERVICE_API_KEY

# Required in production for operator-only model-management endpoints.
ML_OPERATOR_KEY=CHANGE_ME_ML_OPERATOR_KEY

# Open-Weight LLM Platform Configuration
LLM_DEFAULT_PROVIDER=huggingface
LLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LLM_DEVICE=cpu
LLM_QUANTIZATION=float32

# Scheduled Drift Monitor Configuration
# How often (in seconds) the scheduler fires a drift check against the inference buffer.
DRIFT_CHECK_INTERVAL_SECONDS=300
# Minimum number of buffered inference samples required before a drift check runs.
DRIFT_CHECK_MIN_SAMPLES=200
